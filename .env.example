# live/auto: use Shopify's keyless Global Catalog MCP
# mock: always use local demo data
CATALOG_MODE=live

# Public canonical URL used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://sift-shopify-search.vercel.app

SHOPIFY_CATALOG_URL=https://catalog.shopify.com/api/ucp/mcp
SHOPIFY_AGENT_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/2026-04-08/valid-with-capabilities.json
# Optional boundary configured in Shopify's Dev Dashboard.
SHOPIFY_SAVED_CATALOG_SLUG=
